{
  "name": "join-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Join UI — an open-code catalog of motion-first React components with a shadcn-compatible registry.",
  "license": "MIT",
  "author": "Join Way",
  "homepage": "https://ui.join-way.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d1maash/join-ui.git"
  },
  "bugs": {
    "url": "https://github.com/d1maash/join-ui/issues"
  },
  "keywords": [
    "react",
    "nextjs",
    "shadcn",
    "shadcn-registry",
    "tailwindcss",
    "ui-components",
    "design-system",
    "motion",
    "accessibility"
  ],
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "pnpm registry:build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,tsx,mdx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mdx,css,json,md}\"",
    "registry:build": "tsx scripts/build-registry.ts",
    "registry:validate": "tsx scripts/validate-registry.ts",
    "check": "pnpm registry:validate && pnpm typecheck && pnpm lint"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "^16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
