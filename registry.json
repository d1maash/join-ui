        "motion",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils"
      ],
      "categories": [
        "data-display",
        "timeline",
        "stepper",
        "progress",
        "status",
        "order",
        "tracker",
        "steps",
        "delivery"
      ],
      "docs": "https://ui.join-way.com/components/status-timeline",
      "meta": {
        "status": "new",
        "since": "2026-08-02",
        "featured": true,
        "installCommand": "pnpm dlx shadcn@latest add @joinui/status-timeline"
      },
