    {
      "name": "status-timeline",
      "type": "registry:ui",
      "title": "Status Timeline",
      "description": "A colour-coded step tracker for orders, deployments and onboarding, still at rest and animated only when a step advances.",
      "author": "Join Way",
      "dependencies": [
        "motion",
        "lucide-react"
      ],
      "registryDependencies": [
        "utils"
      ],
      "categories": [
        "data-display",
        "timeline",
        "stepper",
        "progress",
        "status",
        "order",
        "tracker",
        "steps",
        "delivery"
      ],
      "docs": "https://ui.join-way.com/components/status-timeline",
      "meta": {
        "status": "stable",
        "since": "2026-08-02",
        "updated": "2026-08-24",
        "featured": true,
        "installCommand": "pnpm dlx shadcn@latest add @joinui/status-timeline"
      },
      "files": [
        {
          "path": "registry/components/status-timeline.tsx",
