          "radius-soft-sm": "0.5rem",
          "radius-soft": "0.75rem",
          "radius-soft-lg": "1.125rem"
        },
        "light": {
          "info": "#0068d1",
          "info-soft": "#e8f1fc",
          "info-foreground": "#ffffff",
          "positive": "#1a7f37",
          "positive-soft": "#e6f4ea",
          "positive-foreground": "#ffffff",
          "caution": "#b05a00",
          "caution-soft": "#fdf1e1",
